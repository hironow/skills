import Glossary.Claim

/-!
# Generated outputs

Turns glossaries (`Book`) into the list of checks and into documents for people to read.
The documents go to `docs/generated/`. Nobody edits them by hand.

This file is the same for every domain. Do not edit it per project.
Choose the language of the generated documents with `Labels` in `Glossary/Registry.lean`.
-/

namespace Glossary

def shortName {α : Type} [Repr α] (a : α) : String :=
  ((reprStr a).splitOn ".").getLast!

def gateLine (expect : String) (r : QuintRef) : String :=
  let kind := if r.temporal then "temporal" else "invariant"
  s!"{expect}\t{kind}\t{r.file}\t{r.main}\t{r.invariant}"

def gateLines {ι : Type} (c : Claim ι) : List String :=
  match c.evidence with
  | .holds r => [gateLine "holds" r]
  | .violated r => [gateLine "violated" r]
  | .question ws => ws.map (gateLine "violated")
  | _ => []

/-- The fixed words used in generated documents. One value per language. -/
