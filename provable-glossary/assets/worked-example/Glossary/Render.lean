def Labels.verdict (l : Labels) : Verdict → String
  | .proved => l.proved
  | .counterexample => l.counterexample
  | .undecided => l.undecided

def refLabel (r : QuintRef) : String := s!"`{r.file}` `{r.main}.{r.invariant}`"

def Labels.evidence (l : Labels) : Evidence → String
  | .lean name _ _ => s!"{l.lean}: `{name}`"
  | .leanRefutes name _ _ => s!"{l.leanRefutes}: `{name}`"
  | .holds r => s!"{l.holds}: {refLabel r}"
  | .violated r => s!"{if r.temporal then l.violatedTemporal else l.violated}: {refLabel r}"
  | .question [] => l.question
  | .question ws => s!"{l.questionWitness}: " ++ ", ".intercalate (ws.map refLabel)

/-- One term, ready to print. -/
structure TermRow where
  label : String
  id : String
  context : String
  gloss : String
  defDeps : String
  assoc : String
  anchors : List String
  role : Option Role

/-- One claim, ready to print. -/
structure ClaimRow where
  verdict : Verdict
  statement : String
  about : String
  /-- The IDs of the terms in `about`, as in `TermRow.id`. -/
  aboutIds : List String
  evidence : String
  /-- Whether the evidence is a Quint check (holds or violated). -/
  quint : Bool

/-- One glossary, ready to print. The term type is erased, so glossaries of different domains fit in one list. -/
structure BookView where
  title : String
  terms : List TermRow
  claims : List ClaimRow
  gate : List String
  stopScene : StopScene

def Book.view {ι κ : Type} [Repr ι] [Repr κ] (l : Labels) (b : Book ι κ) : BookView :=
  let label (t : ι) : String :=
    match b.terms.find? (fun e => shortName e.id == shortName t) with
    | some e => e.label
    | none => shortName t
  let names (ts : List ι) : String := ", ".intercalate (ts.map label)
  { title := b.title
    terms := b.terms.map fun e =>
      { label := e.label, id := shortName e.id, context := shortName e.context, gloss := e.gloss,
        defDeps := names e.defDeps, assoc := names e.assoc, anchors := e.anchors, role := e.role }
    claims := b.claims.map fun c =>
      { verdict := c.verdict, statement := c.statement, about := names c.about,
        aboutIds := c.about.map shortName, evidence := l.evidence c.evidence,
        quint := c.evidence.isQuint }
    gate := b.claims.flatMap gateLines
    stopScene := b.stopScene }

def count (b : BookView) (v : Verdict) : Nat := (b.claims.filter (·.verdict == v)).length

def separator (columns : String) : String :=
  "|" ++ "|".intercalate (List.replicate ((columns.splitOn "|").length - 2) "---") ++ "|"

def glossaryDoc (l : Labels) (books : List BookView) : List String :=
  [l.header, "", s!"# {l.glossaryTitle}", ""] ++ books.flatMap fun b =>
    [s!"## {b.title}", "", s!"### {l.terms}", "", l.termColumns, separator l.termColumns]
    ++ b.terms.map (fun t =>
      s!"| {t.label} | `{t.id}` | {t.context} | {t.gloss} | {t.defDeps} | {t.assoc} |")
    ++ ["", s!"### {l.claims}", "", l.claimColumns, separator l.claimColumns]
    ++ b.claims.map (fun c =>
      s!"| {l.verdict c.verdict} | {c.statement} | {c.about} | {c.evidence} |")
    ++ [""]

def questionsDoc (l : Labels) (books : List BookView) : List String :=
  [l.header, "", s!"# {l.questionsTitle}", "", l.questionsIntro, ""]
  ++ books.flatMap fun b =>
    let qs := b.claims.filter (·.verdict == .undecided)
    [s!"## {b.title}", ""]
    ++ (if qs.isEmpty then [l.noQuestions]
        else [l.questionColumns, separator l.questionColumns]
          ++ qs.map (fun c => s!"| {c.statement} | {c.about} | {c.evidence} |"))
    ++ [""]

def summaryDoc (l : Labels) (books : List BookView) : List String :=
  let total (f : BookView → Nat) : Nat := (books.map f).foldl (· + ·) 0
  let row (name : String) (terms claims p c u : Nat) : String :=
    s!"| {name} | {terms} | {claims} | {p} | {c} | {u} |"
  [l.header, "", s!"# {l.summaryTitle}", "", l.summaryColumns, separator l.summaryColumns]
  ++ books.map (fun b =>
    row b.title b.terms.length b.claims.length
      (count b .proved) (count b .counterexample) (count b .undecided))
  ++ [row l.total (total (·.terms.length)) (total (·.claims.length))
        (total (count · .proved)) (total (count · .counterexample)) (total (count · .undecided)),
      ""]

/-- Splits `path#text` at the first `#`. -/
def splitAnchor (a : String) : String × String :=
  match a.splitOn "#" with
  | [] => (a, "")
  | path :: rest => (path, "#".intercalate rest)

def anchorsDoc (l : Labels) (books : List BookView) : List String :=
  [l.header, "", s!"# {l.anchorsTitle}", "", l.anchorsIntro, ""]
  ++ books.flatMap fun b =>
    let rows := b.terms.flatMap fun t => t.anchors.map fun a =>
      let absent := a.startsWith "!"
      let (path, text) := splitAnchor (if absent then (a.drop 1).toString else a)
      s!"| {t.label} | `{t.id}` | `{path}` | {if absent then l.anchorAbsent else ""}`{text}` |"
    [s!"## {b.title}", ""]
    ++ (if rows.isEmpty then [l.noAnchors] else [l.anchorColumns, separator l.anchorColumns] ++ rows)
    ++ [""]

/-- One line per anchor, for `just anchor-check`: term ID, tab, anchor. -/
def anchorLines (books : List BookView) : List String :=
  books.flatMap fun b => b.terms.flatMap fun t => t.anchors.map fun a => s!"{t.id}\t{a}"

/-- Every term ID, one per line, for `just migration-check`. -/
def termIds (books : List BookView) : List String :=
  books.flatMap fun b => b.terms.map (·.id)

/-- The generated documents: file name and content. -/
def generatedDocs (l : Labels) (books : List BookView) : List (String × List String) :=
  [("glossary.md", glossaryDoc l books),
   ("questions.md", questionsDoc l books),
   ("anchors.md", anchorsDoc l books),
   ("summary.md", summaryDoc l books)]

end Glossary
